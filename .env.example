# .env.example — copy to .env and fill in

# ── Deployment ────────────────────────────────────────────────────────────
DEPLOYER_PRIVATE_KEY=

# ── Source chain (where remittances actually happen, e.g. Ethereum) ───────
SEPOLIA_RPC_URL=
ETHEREUM_MAINNET_RPC_URL=
SOURCE_CHAIN_KEY_TESTNET=1
SOURCE_CHAIN_KEY_MAINNET=1
# ERC20 the worker watches for incoming "remittance" transfers on the source
# chain — e.g. the MockStablecoin from scripts/deployMocks.ts on Sepolia,
# or real USDC on Ethereum mainnet.
SOURCE_REMITTANCE_TOKEN_ADDRESS_TESTNET=
SOURCE_REMITTANCE_TOKEN_ADDRESS_MAINNET=

# ── Creditcoin (where the Attestcoin Smart Contracts live) ────────────────
CC3_TESTNET_RPC_URL=https://rpc.cc3-testnet.creditcoin.network
CC3_TESTNET_CHAIN_ID=102031
CC3_MAINNET_RPC_URL=
CC3_MAINNET_CHAIN_ID=102030

# ── Attestcoin Protocol (usc-sdk) ──────────────────────────────────────────
# Confirm current values against https://docs.creditcoin.org/usc/dapp-builder-infrastructure/usc-sdk
USC_PROVER_API_URL_TESTNET=https://prover.usc-testnet.creditcoin.network
USC_PROVER_API_URL_MAINNET=
ATTESTCOIN_BLOCK_PROVER_PRECOMPILE_ADDRESS=0x0000000000000000000000000000000000000FD2

# ── Deployed contract addresses (filled in by scripts/deploy.ts) ──────────
REMITTANCE_MICRO_LOAN_ADDRESS_TESTNET=
REMITTANCE_MICRO_LOAN_ADDRESS_MAINNET=
CREDIT_REGISTRY_ADDRESS_TESTNET=
CREDIT_REGISTRY_ADDRESS_MAINNET=
CREDIT_DECISION_ENGINE_ADDRESS_TESTNET=
CREDIT_DECISION_ENGINE_ADDRESS_MAINNET=
LOAN_STABLECOIN_ADDRESS_TESTNET=
LOAN_STABLECOIN_ADDRESS_MAINNET=

# ── Environment selector for shared/worker/backend ─────────────────────────
# "testnet" or "mainnet"
NETWORK_ENV=testnet

# ── Worker ──────────────────────────────────────────────────────────────
# Wallet the oracle worker uses to submit proofs / trigger credit reviews.
# Needs a small amount of CTC for gas on Creditcoin.
WORKER_PRIVATE_KEY=
WORKER_POLL_INTERVAL_MS=15000

# ── Backend ─────────────────────────────────────────────────────────────
PORT=4000
# Optional relayer key so the API can submit transactions on a borrower's
# behalf (e.g. for a custodial demo flow). Leave blank to run read-only /
# have the future frontend sign with the user's own wallet instead.
BACKEND_RELAYER_PRIVATE_KEY=



SEPOLIA_WSS_RPC_URL=
ETHEREUM_MAINNET_WSS_RPC_URL=